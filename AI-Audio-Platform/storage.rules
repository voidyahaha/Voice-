rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/jobs/{jobId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && fileName.matches('original.*') && request.resource.size < 250 * 1024 * 1024 && request.resource.contentType.matches('audio/.*');
      allow update, delete: if false;
    }
  }
}
